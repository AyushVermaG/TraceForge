# Neo4j Database Connection Credentials (AuraDB or Local)
# For Neo4j AuraDB: neo4j+s://<db-instance-id>.databases.neo4j.io
# For Local Neo4j: bolt://localhost:7687
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-secure-password
NEO4J_DATABASE=neo4j

# Application Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
RELOAD=false

# Security & Upload Controls
MAX_UPLOAD_SIZE_MB=25
MAX_FILES_COUNT=1000
STORAGE_DIR=./data/repos
